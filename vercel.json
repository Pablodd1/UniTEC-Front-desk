{
  "cleanUrls": true,
  "rewrites": [
    {"source": "/api/(.*)", "destination": "/api/$1"},
    {"source": "/(.*)", "destination": "/index.html"}
  ],
  "crons": [
    {
      "path": "/api/daily-analytics",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/health",
      "schedule": "0 * * * *"
    }
  ]
}
