{
  "cleanUrls": true,
  "rewrites": [
    {"source": "/api/(.*)", "destination": "/api/$1"},
    {"source": "/(.*)", "destination": "/index"}
  ],
  "crons": [
    {
      "path": "/api/daily-analytics",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/warm",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/lifecycle-sweep",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/abandon-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/staff-sla-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/chatbot-watch",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/mission-control-export?window=24",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/ga-visits",
      "schedule": "0 13 * * *"
    }
  ]
}
