{
  "cleanUrls": true,
  "rewrites": [
    {"source": "/api/(.*)", "destination": "/api/$1"},
    {"source": "/(.*)", "destination": "/index.html"}
  ],
  "crons": [
    {
      "path": "/api/daily-analytics",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/warm",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/lifecycle-sweep",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/ga-visits",
      "schedule": "0 13 * * *"
    }
  ]
}
