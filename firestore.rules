rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Any authenticated user qualifies - the admin is gated by app-level password check (signInAnonymously)
      return isAuthenticated();
    }
    
    function isStaff() {
      // Any authenticated user qualifies - the admin is gated by app-level password check (signInAnonymously)
      return isAuthenticated();
    }
    
    function uidUnchanged() {
      return !('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid;
    }
    
    function uidNotModified() {
      return !('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId;
    }
    
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidCrmLog() {
      return hasRequiredFields(['id', 'timestamp', 'customerName', 'summary', 'actionTaken', 'sentiment', 'userId']) &&
             request.resource.data.id is string && request.resource.data.id.size() < 100 &&
             request.resource.data.timestamp is string && request.resource.data.timestamp.size() < 50 &&
             request.resource.data.customerName is string && request.resource.data.customerName.size() < 200 &&
             request.resource.data.summary is string && request.resource.data.summary.size() < 2000 &&
             request.resource.data.actionTaken is string && request.resource.data.actionTaken.size() < 1000 &&
             request.resource.data.sentiment in ['Positive', 'Neutral', 'Negative'] &&
             (!('provider' in request.resource.data) || request.resource.data.provider in ['Internal', 'Escala']) &&
             request.resource.data.userId is string && request.resource.data.userId.size() < 100;
    }
    
    function isValidCallRecording() {
      return hasRequiredFields(['id', 'name', 'timestamp', 'duration', 'userId']) &&
             request.resource.data.id is string && request.resource.data.id.size() < 100 &&
             request.resource.data.name is string && request.resource.data.name.size() < 200 &&
             request.resource.data.timestamp is string && request.resource.data.timestamp.size() < 50 &&
             request.resource.data.duration is string && request.resource.data.duration.size() < 50 &&
             (!('blobUrl' in request.resource.data) || (request.resource.data.blobUrl is string && request.resource.data.blobUrl.size() < 2000)) &&
             (!('transcript' in request.resource.data) || (request.resource.data.transcript is string && request.resource.data.transcript.size() < 100000)) &&
             request.resource.data.userId is string && request.resource.data.userId.size() < 100;
    }

    function isValidAppConfig() {
      return hasRequiredFields(['userId']) &&
             (!('escalaApiKey' in request.resource.data) || (request.resource.data.escalaApiKey is string && request.resource.data.escalaApiKey.size() < 500)) &&
             (!('escalaAccountId' in request.resource.data) || (request.resource.data.escalaAccountId is string && request.resource.data.escalaAccountId.size() < 500)) &&
             (!('escalaIsActive' in request.resource.data) || request.resource.data.escalaIsActive is bool) &&
             (!('trainingData' in request.resource.data) || (request.resource.data.trainingData is string && request.resource.data.trainingData.size() < 500000)) &&
             (!('geminiApiKey' in request.resource.data)) &&
             request.resource.data.userId is string && request.resource.data.userId.size() < 100;
    }

    function isValidConversation() {
      return request.resource.data.keys().hasAll(['id', 'status', 'brandId', 'createdAt', 'lastUpdated']) &&
             request.resource.data.id is string &&
             request.resource.data.status in ['active', 'human_requested', 'human_assigned', 'completed', 'abandoned'] &&
             request.resource.data.brandId in ['unitec', 'building'] &&
             request.resource.data.createdAt is string &&
             request.resource.data.lastUpdated is string;
    }
    
    function isValidMessage() {
      return request.resource.data.keys().hasAll(['id', 'role', 'text', 'timestamp']) &&
             request.resource.data.id is string &&
             request.resource.data.role in ['user', 'model', 'staff'] &&
             request.resource.data.text is string &&
             request.resource.data.text.size() < 10000 &&
             request.resource.data.timestamp is string;
    }
    
    function isValidIntervention() {
      return request.resource.data.keys().hasAll(['id', 'sessionId', 'requestedAt', 'status', 'requestedBy', 'reason', 'priority']) &&
             request.resource.data.id is string &&
             request.resource.data.sessionId is string &&
             request.resource.data.status in ['pending', 'accepted', 'resolved', 'timeout'] &&
             request.resource.data.requestedBy in ['user', 'system', 'staff'] &&
             request.resource.data.reason is string &&
             request.resource.data.priority in ['low', 'medium', 'high', 'urgent'];
    }
    
    function isValidCall() {
      return request.resource.data.keys().hasAll(['id', 'to', 'from', 'status', 'direction', 'startedAt']) &&
             request.resource.data.id is string &&
             request.resource.data.status in ['initiated', 'ringing', 'in-progress', 'completed', 'failed', 'busy', 'no-answer'] &&
             request.resource.data.direction in ['outbound', 'inbound'];
    }

    // ===============================================================
    // Rules
    // ===============================================================
    
    // -- User-scoped data (requires auth + ownership) --
    match /users/{userId}/crmLogs/{logId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidCrmLog() && uidUnchanged();
      allow update: if isOwner(userId) && isValidCrmLog() && uidNotModified();
      allow delete: if isOwner(userId);
    }
    
    match /users/{userId}/callRecordings/{recordingId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidCallRecording() && uidUnchanged();
      allow update: if isOwner(userId) && isValidCallRecording() && uidNotModified();
      allow delete: if isOwner(userId);
    }
    
    match /users/{userId}/config/main {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidAppConfig() && uidUnchanged();
      allow update: if isOwner(userId) && isValidAppConfig() && uidNotModified();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/chatSessions/{sessionId} {
      allow read, write: if isOwner(userId);
    }
    
    // -- Conversations: public create & get (visitors), authenticated list & write (admin), public update (visitors) --
    match /conversations/{sessionId} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if isValidConversation();
      allow update: if isStaff() || (!isAuthenticated() && request.resource.data.id == resource.data.id);
      allow delete: if isAdmin();
      
      // -- Messages subcollection: public read & create, authenticated update/delete --
      match /messages/{messageId} {
        allow read: if true;
        allow create: if isValidMessage();
        allow update: if isStaff();
        allow delete: if isAdmin();
      }
    }

    
    // -- Interventions: authenticated access, public create --
    match /interventions/{interventionId} {
      allow get: if isStaff();
      allow list: if isStaff();
      allow create: if isValidIntervention();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }
    
    // -- Calls: authenticated only --
    match /calls/{callId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidCall();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // -- Staff: authenticated read, admin write --
    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }
    
    // -- Notifications: authenticated read/update, public create --
    match /notifications/{notificationId} {
      allow read, update: if isStaff();
      allow create: if true;
    }
  }
}