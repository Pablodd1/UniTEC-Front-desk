# Google Gemini API Key (Required for AI chat and voice)
VITE_API_KEY=your_google_gemini_api_key_here

# ElevenLabs API Key (Optional, for custom voice cloning and TTS)
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Groq API Key (Optional failover backup for chatbot)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Fish Audio API Key (Primary TTS — superior Spanish + emotion control)
# Get key at https://fish.audio — free tier available
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here

# xAI Grok Voice (llamada de voz en vivo del chatbot)
# Requerida: sin XAI_API_KEY el cliente cae al motor anterior.
XAI_API_KEY=your_xai_api_key_here
# Voz clonada del dueño (console.x.ai → Voice Library → ⋯ → Copy Voice ID, 8 caracteres).
# Vacío = voz integrada 'celeste'.
XAI_VOICE_ID=

# ─── Monitor del chatbot (/api/chatbot-watch, cron cada 2 h) ───
# Chat de Telegram que recibe TODOS los reportes (coma-separado para varios).
NANCY_TELEGRAM_CHAT_ID=
# Respaldo opcional si Nancy no está configurada. Sin ninguno de los dos, NO se envía
# (el monitor nunca escribe al grupo del equipo por su cuenta).
MONITOR_TELEGRAM_CHAT_ID=
# Token que protege /api/mission-control-export (GET). 32+ caracteres aleatorios.
MC_EXPORT_TOKEN=
# Push del reporte a Mission Control (opcional). Si falta MC_INGEST_URL, se omite y se registra.
MC_INGEST_URL=
MC_INGEST_TOKEN=

# Twilio (WhatsApp/SMS alerts on escalation — fires alongside Sent.dm)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── Jev error monitor (scripts/jev-audit.mjs + .github/workflows/jev-monitor.yml) ───
# TypeSafe System One key — console.typesafe.ai. Without it the audit runs heuristic-only.
TYPESAFE_API_KEY=your_typesafe_api_key_here
# Valid model ids: jev-latest (-> jev-1.13.0) | jev-1.13.0 | jev-preview. "jev-1" does NOT exist.
TYPESAFE_MODEL=jev-latest
# Target site audited by the monitor (defaults to production when unset)
BASE_URL=https://unitec-front-desk.vercel.app
# Notification channels — optional, but without one nobody is told about an incident
RESEND_API_KEY=your_resend_api_key_here
NOTIFICATION_EMAIL=you@example.com
NOTIFICATION_FROM=Jev Monitor <onboarding@resend.dev>
JEV_WEBHOOK_URL=https://hooks.example.com/jev
