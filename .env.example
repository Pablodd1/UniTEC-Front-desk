# Google Gemini API Key (Required for AI chat and voice)
VITE_API_KEY=your_google_gemini_api_key_here

# ElevenLabs API Key (Optional, for custom voice cloning and TTS)
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Groq API Key (Optional failover backup for chatbot)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Fish Audio API Key (Primary TTS — superior Spanish + emotion control)
# Get key at https://fish.audio — free tier available
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here

# Twilio (WhatsApp/SMS alerts on escalation — fires alongside Sent.dm)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
